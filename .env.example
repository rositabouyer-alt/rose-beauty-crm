# ============================================
# ROSE BEAUTY CRM - Environment Configuration
# Copy this file to ".env" and fill in your own values
# ============================================

# Server
PORT=4000
ADMIN_PHONE=+10000000000

# ---- AI ENGINE ----
# Mode: "local"  -> uses the built-in rule-based smart responder (works out of the box, no key needed)
#       "ollama" -> uses a local Ollama model (e.g. gemma3:4b). Requires Ollama running locally.
#       "api"    -> forwards the conversation to any OpenAI-compatible LLM endpoint
AI_MODE=local

# Used only when AI_MODE=ollama (https://ollama.com)
#   ollama pull gemma3:4b
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=gemma3:4b

# Used only when AI_MODE=api
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=REPLACE_ME
AI_MODEL=gpt-4o-mini

# ---- TELEGRAM BOT ----
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_ENABLED=true

# ---- SMS PROVIDER ----
# Any provider works (Twilio, Kavenegar, SMS.ir, etc). Fill sendSms() in server/bot/sms.js
SMS_ENABLED=false
SMS_API_URL=REPLACE_ME
SMS_API_KEY=REPLACE_ME
SMS_SENDER_NUMBER=REPLACE_ME

# ---- WHATSAPP / INSTAGRAM (via Meta Cloud API) ----
WHATSAPP_TOKEN=REPLACE_ME
WHATSAPP_PHONE_ID=REPLACE_ME
INSTAGRAM_TOKEN=REPLACE_ME
META_VERIFY_TOKEN=REPLACE_ME

# ---- GOOGLE CALENDAR ----
# Every confirmed booking automatically creates a calendar event.
# See server/bot/googleCalendar.js for the one-time setup steps to get
# a client id/secret + refresh token from Google Cloud Console.

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_REFRESH_TOKEN=REPLACE_ME
GOOGLE_CALENDAR_ID=primary